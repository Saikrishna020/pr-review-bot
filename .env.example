# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# GitHub personal access token, needs `repo` scope (or fine-grained
# contents:read + pull_requests:write) to read PR diffs and post comments.
GITHUB_TOKEN=

# Repo the bot actually reads from / posts to. Leave unset to default to
# the pallets/click demo repo for read-only local testing (posting there
# is always blocked, see review_real_pr.py BLOCKED_TARGETS).
TARGET_OWNER=
TARGET_REPO=

# Must be "true" (exact) before the bot will post any comment, on either
# the manual CLI script or the /webhook endpoint. Defaults to a dry run.
POST_COMMENTS=false

# Optional: GitHub webhook secret, used to verify X-Hub-Signature-256 on
# incoming /webhook requests. Set the same value in the repo's webhook
# config. If left blank, signature verification is skipped (fine for
# early local testing with ngrok, not recommended once deployed).
GITHUB_WEBHOOK_SECRET=

# Optional: Jira, for ticket-alignment review. If any of the three is
# missing the bot silently falls back to a code-only review, so leaving
# this whole block blank is a supported configuration.
#
# JIRA_DOMAIN is the subdomain only: for https://acme.atlassian.net use
# "acme". JIRA_EMAIL must be the exact address the Atlassian account logs
# in with, and JIRA_API_TOKEN a token generated under that same account at
# https://id.atlassian.com/manage-profile/security/api-tokens (Jira Cloud
# authenticates as email + token, so the token alone is not enough).
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Only used by the eval scripts, to know which project the golden-set
# tickets live in. Not needed by the bot itself.
JIRA_PROJECT_KEY=
